# Environment: development or production
APP_ENV=development
LOG_LEVEL=INFO

# Database Settings
# For Docker Compose, the host is 'db'. For local host development, use 'localhost'.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/lenny_growth_assistant

# LLM Providers (ollama or anthropic)
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=none
LLM_TIMEOUT_SECONDS=300

# Ollama Settings
# If running backend in Docker and Ollama on host, use host.docker.internal
# If running backend locally without Docker, use http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Anthropic Settings (Optional)
ANTHROPIC_API_KEY=

# Agent Settings
AGENT_MAX_HISTORY_MESSAGES=12

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
